{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/yakami0129/multisoul/scripts/docs-indices.schema.json",
  "title": "docs index checker config",
  "type": "object",
  "required": ["version", "indices"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "indices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "root", "filePattern", "sortDocuments"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "root": {
            "type": "string",
            "pattern": "^docs/[a-z0-9-]+$"
          },
          "filePattern": { "type": "string", "minLength": 1 },
          "sortDocuments": {
            "type": "string",
            "enum": ["filename_asc", "filename_desc"]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
