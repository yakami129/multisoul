#!/usr/bin/env bash
# Harness pre-commit gate. Order: cheap checks first.
# Each rule's source of truth: docs/quality/mechanized-constraints.md.

set -e

# Resolve repo root (this script may be invoked from sub-directories).
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# 1. AGENTS.md size cap (instant)
bash scripts/check-agents-md-size.sh

# 2. No hardcoded secrets (regex over staged files)
bash scripts/check-no-secrets.sh --staged

# 3. Mobile palette compliance (regex over staged mobile/ files)
# bash scripts/check-mobile-colors.sh --staged

# 3b. Single-file line cap (staged paths only)
bash scripts/check-max-file-lines.sh --staged

# 3c. No #[allow(...)] in Rust source (staged paths only)
bash scripts/check-no-allow.sh --staged

# 3c1. CLI unit tests live under cli/tests/ (staged paths only)
bash scripts/check-cli-test-layout.sh --staged

# 3c1b. CLI top-level command grouping (always scans cli/src/main.rs)
bash scripts/check-cli-command-layout.sh --staged

# 3c1c. Project skill adapters stay wired for Claude/Cursor/Codex
staged_agent_skills=$(
  git diff --cached --name-only --diff-filter=ACMR |
    grep -E '^(\.agents/skills/custom-lint/|\.claude/skills/custom-lint/|\.cursor/rules/custom-lint\.mdc|AGENTS\.md|CLAUDE\.md|scripts/check-agent-skill-adapters\.py)' ||
    true
)
if [ -n "$staged_agent_skills" ]; then
  python3 scripts/check-agent-skill-adapters.py
fi

# 3e. iOS Info.plist permission alignment (staged paths only)
bash scripts/check-ios-permissions.sh --staged

# 3c2. Design-doc code hash freshness (when tracked source files are staged)
staged_tracked=$(
  git diff --cached --name-only --diff-filter=ACMR |
    grep -E '\.(rs|ts|tsx)$' || true
)
if [ -n "$staged_tracked" ]; then
  python3 scripts/check-doc-code-hashes.py --check
fi

# 3d. Canonical docs manifests (product-specs / design-docs / exec-plans)
staged_docs_indices=$(
  git diff --cached --name-only --diff-filter=ACMR |
    grep -E '^(docs/(product-specs|design-docs|exec-plans)/|scripts/docs-indices\.json|scripts/check-docs-indices\.py)' ||
    true
)
if [ -n "$staged_docs_indices" ]; then
  python3 scripts/check-docs-indices.py
fi

# 4. ESLint + prettier on staged TS/TSX (existing lint-staged config)
staged_mobile=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^mobile/(src|app)/.*\.(ts|tsx)$' || true)
if [ -n "$staged_mobile" ]; then
  ( cd mobile && pnpm exec lint-staged )
fi

# 5. Typecheck only when the relevant package changed (skip for docs-only commits).
if [ -n "$staged_mobile" ]; then
  echo "[pre-commit] running mobile typecheck..."
  ( cd mobile && pnpm typecheck )
fi

staged_cli=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^cli/.*\.rs$' || true)
if [ -n "$staged_cli" ]; then
  echo "[pre-commit] running cargo check..."
  ( cd cli && cargo check --quiet )
  echo "[pre-commit] running cargo fmt --check..."
  ( cd cli && cargo fmt --check )
fi

exit 0
