{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/yakami0129/multisoul/docs/design-docs/index.schema.json",
  "title": "design-docs manifest",
  "type": "object",
  "required": ["version", "documents"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema pointer for editor validation."
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "documents": {
      "type": "array",
      "description": "One entry per design markdown in this directory (excluding README.md). Prefer reverse lexicographic order by file for stable diffs.",
      "items": {
        "type": "object",
        "required": ["file", "title"],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+-(design|guide)\\.md$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "trackedFiles": {
            "type": "array",
            "description": "Code files whose content hash must stay synchronized with this design document.",
            "items": {
              "type": "object",
              "required": ["path", "sha256", "reason"],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Repo-root relative path to a tracked code file."
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Why this code file affects the design document."
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
