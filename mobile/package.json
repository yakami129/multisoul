{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "start": "expo start",
    "prestart": "node scripts/generate-mermaid-asset.mjs",
    "android": "expo run:android",
    "preandroid": "node scripts/generate-mermaid-asset.mjs",
    "ios": "expo run:ios",
    "preios": "node scripts/generate-mermaid-asset.mjs",
    "web": "expo start --web",
    "preweb": "node scripts/generate-mermaid-asset.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "generate:mermaid": "node scripts/generate-mermaid-asset.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "prepare": "husky",
    "postinstall": "node scripts/generate-mermaid-asset.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.99.1",
    "axios": "^1.15.0",
    "babel-preset-expo": "~55.0.17",
    "expo": "55.0.27",
    "expo-asset": "~55.0.17",
    "expo-audio": "~55.0.15",
    "expo-camera": "~55.0.20",
    "expo-clipboard": "^55.0.14",
    "expo-constants": "~55.0.16",
    "expo-file-system": "~55.0.23",
    "expo-image-manipulator": "^55.0.18",
    "expo-image-picker": "^55.0.21",
    "expo-linking": "~55.0.16",
    "expo-localization": "~55.0.16",
    "expo-notifications": "~55.0.24",
    "expo-router": "~55.0.16",
    "expo-speech-recognition": "3.1.3",
    "expo-sqlite": "~55.0.17",
    "expo-status-bar": "~55.0.6",
    "expo-video": "~55.0.18",
    "i18next": "^26.3.1",
    "mermaid": "11.15.0",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "^2.31.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.19",
    "uuid": "^10.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.10",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-native": "^4.1.0",
    "husky": "^9.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.19",
    "lint-staged": "^15.0.0",
    "lucide-react-native": "^1.8.0",
    "msw": "^2.14.6",
    "prettier": "^3.0.0",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "expo-image-loader": "55.0.1",
      "react": "19.2.0",
      "react-test-renderer": "19.2.0"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "app/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-gesture-handler"
      ]
    }
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/ios",
    "testEnvironment": "<rootDir>/jest.environment.js",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/node_modules/jest-expo/src/preset/setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^react-native-css-interop/jsx-runtime$": "react/jsx-runtime",
      "^react-native-css-interop/jsx-dev-runtime$": "react/jsx-dev-runtime",
      "\\.css$": "<rootDir>/src/__mocks__/fileMock.js"
    },
    "coverageThreshold": {
      "global": {
        "lines": 60
      }
    }
  }
}
