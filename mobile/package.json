{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.99.1",
    "axios": "^1.15.0",
    "babel-preset-expo": "~55.0.17",
    "expo": "~55.0.17",
    "expo-camera": "16.1.6",
    "expo-constants": "~55.0.14",
    "expo-linking": "~55.0.14",
    "expo-notifications": "~0.31.2",
    "expo-router": "~55.0.13",
    "expo-sqlite": "~15.2.10",
    "expo-status-bar": "~55.0.5",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.19",
    "uuid": "^10.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.10",
    "@types/uuid": "^10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.16",
    "lucide-react-native": "^1.8.0",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-test-renderer": "19.2.0"
    }
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/ios",
    "testEnvironment": "<rootDir>/jest.environment.js",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/node_modules/jest-expo/src/preset/setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^react-native-css-interop/jsx-runtime$": "react/jsx-runtime",
      "^react-native-css-interop/jsx-dev-runtime$": "react/jsx-dev-runtime"
    }
  }
}
